# ─────────────────────────────────────────────
# Portfolio Configuration
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed.
# ─────────────────────────────────────────────

# Public URL of your deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ─── Admin PIN ────────────────────────────────
# 4-digit PIN to access /admin and /full routes
PORTFOLIO_PIN=1234

# ─── HMAC Secret ──────────────────────────────
# 64-character hex string used to sign auth cookies and shareable tokens.
# Generate one with: openssl rand -hex 32
PORTFOLIO_TOKEN_SECRET=replace_with_64_char_hex_secret

# ─── Upstash Redis (optional) ─────────────────
# Required only if you want the admin CMS to persist changes across deploys.
# Without Redis, content comes from config/portfolio.ts and lib/i18n/ files.
# Create a free database at https://console.upstash.com
KV_REST_API_URL=https://your-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_api_token
